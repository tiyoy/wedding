<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 850" width="700" height="850">
  <defs>
    <linearGradient id="grad_galleryjpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f2f4f1" />
      <stop offset="100%" stop-color="#fff" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#8a9a86" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#8a9a86" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="700" height="850" fill="url(#grad_galleryjpg)" />
  <rect width="700" height="850" fill="url(#glow)" />

  <!-- Elegant Inner Border -->
  <rect x="20" y="20" width="660" height="810" rx="12" fill="none" stroke="#8a9a86" stroke-width="1.5" stroke-opacity="0.4" stroke-dasharray="8 4"/>
  <rect x="28" y="28" width="644" height="794" rx="8" fill="none" stroke="#8a9a86" stroke-width="0.8" stroke-opacity="0.3"/>

  <!-- Corner flourishes -->
  <circle cx="28" cy="28" r="4" fill="#8a9a86" opacity="0.6"/>
  <circle cx="672" cy="28" r="4" fill="#8a9a86" opacity="0.6"/>
  <circle cx="28" cy="822" r="4" fill="#8a9a86" opacity="0.6"/>
  <circle cx="672" cy="822" r="4" fill="#8a9a86" opacity="0.6"/>

  
  <!-- Center Emblem -->
  <circle cx="350" cy="390" r="55" fill="#ffffff" stroke="#8a9a86" stroke-width="2" opacity="0.9"/>
  <text x="350" y="405" font-size="36" text-anchor="middle">🌿</text>

  <!-- Title & Subtitle -->
  <text x="350" y="480" font-family="'Playfair Display', 'Cormorant Garamond', serif" font-size="24" font-weight="600" fill="#2d3748" text-anchor="middle" letter-spacing="1">Senyuman Kasih</text>
  <text x="350" y="510" font-family="'Montserrat', sans-serif" font-size="13" font-weight="400" fill="#8a9a86" text-anchor="middle" letter-spacing="2">PREWEDDING 02</text>
  <text x="350" y="540" font-family="'Montserrat', sans-serif" font-size="11" fill="#a0aec0" text-anchor="middle">(Ganti dengan foto asli Anda di folder assets/images/)</text>
  
</svg>