<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="800" height="1000">
  <defs>
    <linearGradient id="grad_coupleherojpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5e6e8" />
      <stop offset="100%" stop-color="#fff" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#b56576" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#b56576" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="1000" fill="url(#grad_coupleherojpg)" />
  <rect width="800" height="1000" fill="url(#glow)" />

  <!-- Elegant Inner Border -->
  <rect x="20" y="20" width="760" height="960" rx="12" fill="none" stroke="#b56576" stroke-width="1.5" stroke-opacity="0.4" stroke-dasharray="8 4"/>
  <rect x="28" y="28" width="744" height="944" rx="8" fill="none" stroke="#b56576" stroke-width="0.8" stroke-opacity="0.3"/>

  <!-- Corner flourishes -->
  <circle cx="28" cy="28" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="772" cy="28" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="28" cy="972" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="772" cy="972" r="4" fill="#b56576" opacity="0.6"/>

  
  <!-- Center Emblem -->
  <circle cx="400" cy="465" r="55" fill="#ffffff" stroke="#b56576" stroke-width="2" opacity="0.9"/>
  <text x="400" y="480" font-size="36" text-anchor="middle">✨</text>

  <!-- Title & Subtitle -->
  <text x="400" y="555" font-family="'Playfair Display', 'Cormorant Garamond', serif" font-size="24" font-weight="600" fill="#2d3748" text-anchor="middle" letter-spacing="1">Save The Date</text>
  <text x="400" y="585" font-family="'Montserrat', sans-serif" font-size="13" font-weight="400" fill="#b56576" text-anchor="middle" letter-spacing="2">28 OKTOBER 2026</text>
  <text x="400" y="615" font-family="'Montserrat', sans-serif" font-size="11" fill="#a0aec0" text-anchor="middle">(Ganti dengan foto asli Anda di folder assets/images/)</text>
  
</svg>