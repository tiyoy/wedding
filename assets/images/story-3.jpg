<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="600" height="450">
  <defs>
    <linearGradient id="grad_storyjpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5eaec" />
      <stop offset="100%" stop-color="#fff" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#b56576" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#b56576" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="600" height="450" fill="url(#grad_storyjpg)" />
  <rect width="600" height="450" fill="url(#glow)" />

  <!-- Elegant Inner Border -->
  <rect x="20" y="20" width="560" height="410" rx="12" fill="none" stroke="#b56576" stroke-width="1.5" stroke-opacity="0.4" stroke-dasharray="8 4"/>
  <rect x="28" y="28" width="544" height="394" rx="8" fill="none" stroke="#b56576" stroke-width="0.8" stroke-opacity="0.3"/>

  <!-- Corner flourishes -->
  <circle cx="28" cy="28" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="572" cy="28" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="28" cy="422" r="4" fill="#b56576" opacity="0.6"/>
  <circle cx="572" cy="422" r="4" fill="#b56576" opacity="0.6"/>

  
  <!-- Center Emblem -->
  <circle cx="300" cy="190" r="55" fill="#ffffff" stroke="#b56576" stroke-width="2" opacity="0.9"/>
  <text x="300" y="205" font-size="36" text-anchor="middle">💍</text>

  <!-- Title & Subtitle -->
  <text x="300" y="280" font-family="'Playfair Display', 'Cormorant Garamond', serif" font-size="20" font-weight="600" fill="#2d3748" text-anchor="middle" letter-spacing="1">Hari Pertunangan</text>
  <text x="300" y="310" font-family="'Montserrat', sans-serif" font-size="13" font-weight="400" fill="#b56576" text-anchor="middle" letter-spacing="2">TAHUN 2025</text>
  <text x="300" y="340" font-family="'Montserrat', sans-serif" font-size="11" fill="#a0aec0" text-anchor="middle">(Ganti dengan foto asli Anda di folder assets/images/)</text>
  
</svg>